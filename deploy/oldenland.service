# systemd unit: serves the built site (./out) on 127.0.0.1:4804 for nginx to proxy.
# Install:  cp deploy/oldenland.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now oldenland
# Adjust WorkingDirectory if the repository lives somewhere else.
[Unit]
Description=Oldenland website (static, port 4804)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/oldenland
Environment=PORT=4804
ExecStart=/usr/bin/env npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
